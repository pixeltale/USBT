#===============================================================================
#
#-------------------------------------------------------------------------------
#Run Fwd
if command = "FF" && stateType = S && ctrl {
	changeState{value: 100}
}

#-------------------------------------------------------------------------------
#Run Back
if command = "BB" && stateType = S && ctrl {
	changeState{value: 105}
}

#-------------------------------------------------------------------------------
#Kung Fu Throw
if command = "Throw" && stateType = S && ctrl && stateNo != 100 && (p2StateType = S || p2StateType = C) && p2MoveType != H &&
	((command = "holdfwd") ||
		(command = "holdback")) {
	changeState{value: 800}
}


#-------------------------------------------------------------------------------
#Taunt
if command = "start" && command != "holddown" && stateType != A && ctrl {
	changeState{value: 195}
}

#===============================================================================
# Normals
#-------------------------------------------------------------------------------
#5A
if command = "a" && command != "holddown" && statetype != A &&
	((ctrl || (stateNo = 200 || stateno = 400) && movecontact)) {
	changeState{value: 200}
}

#-------------------------------------------------------------------------------
#5B
if command = "b" && command != "holddown" && statetype != A &&
	((ctrl || (stateNo = 200 || stateno = 400) && movecontact)) {
	changeState{value: 210}
}

#-------------------------------------------------------------------------------
#6C
if command = "c" && Command = "holdfwd" && statetype != A &&
	((ctrl || (stateNo = [200, 220] || stateno = [400, 420]) && movecontact)) {
	changeState{value: 230}
}

#-------------------------------------------------------------------------------
#5C
if command = "c" &&Command != "holddown" && statetype != A &&
	((ctrl || (stateNo = [200, 210] || stateno = [400, 410]) && movecontact)) {
	changeState{value: 220}
}

#-------------------------------------------------------------------------------
#2A
if command = "a" && command = "holddown" && statetype != A &&
	((ctrl || (stateNo = 200 || stateno = 400) && movecontact)) {
	changeState{value: 400}
}

#-------------------------------------------------------------------------------
#2B
if command = "b" && command = "holddown" && statetype != A &&
	((ctrl || (stateNo = 200 || stateno = 400) && movecontact)) {
	changeState{value: 410}
}

#-------------------------------------------------------------------------------
#2C
if command = "c" && command = "holddown" && statetype != A &&
	((ctrl || (stateNo = [200, 210] || stateno = [400, 410]) && movecontact)) {
	changeState{value: 420}
}

#-------------------------------------------------------------------------------
#5S
if command = "x"  && statetype != A &&
	((ctrl || 
		(stateNo = [200, 220] || stateno = [400, 420]) && movecontact)) {
	changeState{value: 500}
}

#-------------------------------------------------------------------------------
#jA
if command = "a" && statetype = A &&
	((ctrl) || (stateNo = 600 && movecontact)) {
	changeState{value: 600}
}

#-------------------------------------------------------------------------------
#jB
if command = "b" && statetype = A &&
	((ctrl) || (stateNo = 600 && movecontact)) {
	changeState{value: 610}
}

#-------------------------------------------------------------------------------
#jC
if command = "c" && statetype = A &&
	((ctrl) || (stateNo = [600, 610] && movecontact)) {
	changeState{value: 620}
}

#jS
if command = "x" && statetype = A &&
	((ctrl) || (stateNo = [600, 620] && movecontact)) {
	changeState{value: 630}
}
#End of file: roundState = 2
