#;====================================================================================

ignorehitpause if roundstate = 2 && teammode = tag && !ishelper && power > 999 && playerno = teamleader && map(partnersAlive) > 0 && (map(nextPartnerIsReady) || map(previousPartnerIsReady))  {
	ignorehitpause if ((stateno = [const(normalAttacksStartStateno),const(normalAttacksEndStateno)] && statetype != A) || 
	(stateno = [const(specialAttacksStartStateno),const(specialAttacksEndStateno)])) && 
	((movehit && AnimElemVar(NumClsn1) > 0) || (ProjHitTime(0) != -1 && ProjHitTime(0) < 30) || map(customSpecialSwitch)) && 
	const(switchOnNormalOrSpecial) > 0 && !map(switchOnCombo) && AnimElemVar(NumClsn1) > 0 && !map(switchOnComboCooldown) {
		teammapset{map:"switchOnCombo"; value: 1}
	}
}

ignorehitpause if numenemy{
ignorehitpause if player(enemynear,teamleader),movetype != H  || 
